---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';

const BASE = import.meta.env.BASE_URL;
---

<header>
	<nav>
		<a href={BASE} class="wordmark">{SITE_TITLE}</a>
		<div class="internal-links">
			<HeaderLink href={BASE}>홈</HeaderLink>
			<HeaderLink href={`${BASE}about/`}>소개</HeaderLink>
		</div>
		<div class="external-links">
			<a href={`${BASE}admin/?new=1`} id="write-btn" hidden>✏️ 새 글</a>
			<a href="https://minsuk-ji.github.io/" target="_blank">포트폴리오 ↗</a>
			<a href="https://github.com/Minsuk-ji" target="_blank">GitHub ↗</a>
		</div>
	</nav>
</header>
<script>
	if (localStorage.getItem('mn_admin_token')) {
		document.getElementById('write-btn')?.removeAttribute('hidden');
	}
</script>
<style>
	header {
		border-bottom: 1px solid var(--line);
	}
	nav {
		width: 680px;
		max-width: calc(100% - 2.5em);
		margin: auto;
		display: flex;
		align-items: center;
		gap: 2em;
		padding: 1.3em 0;
	}
	.wordmark {
		font-family: var(--font-serif);
		font-weight: 600;
		font-size: 1.1em;
		color: rgb(var(--ink));
		text-decoration: none;
	}
	.internal-links {
		display: flex;
		gap: 1.3em;
		flex: 1;
	}
	.internal-links :global(a) {
		color: rgb(var(--muted));
		font-size: 0.95em;
	}
	.internal-links :global(a.active) {
		color: rgb(var(--ink));
	}
	.external-links {
		display: flex;
		gap: 1.2em;
	}
	.external-links a {
		color: rgb(var(--muted));
		font-size: 0.85em;
		text-decoration: none;
		white-space: nowrap;
	}
	.external-links a:hover {
		color: var(--accent);
	}
	@media (max-width: 560px) {
		.external-links {
			display: none;
		}
	}
</style>

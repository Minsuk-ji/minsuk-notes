---
const today = new Date();
const BASE = import.meta.env.BASE_URL;
---

<footer>
	<span>&copy; {today.getFullYear()} Minsuk Ji</span>
	<a href={`${BASE}rss.xml`}>RSS</a>
</footer>
<style>
	footer {
		width: 680px;
		max-width: calc(100% - 2.5em);
		margin: 4em auto 2.5em auto;
		padding-top: 1.5em;
		border-top: 1px solid var(--line);
		color: rgb(var(--muted));
		font-size: 0.85em;
		display: flex;
		justify-content: space-between;
	}
	footer a {
		color: rgb(var(--muted));
	}
	footer a:hover {
		color: var(--accent);
	}
</style>

---
import CategoryTree from './CategoryTree.astro';
import type { CategoryNode } from '../lib/categories';

interface Props {
	nodes: CategoryNode[];
	depth?: number;
}

const { nodes, depth = 0 } = Astro.props;
---

<ul class="cat-tree" data-depth={depth}>
	{
		nodes.map((node) => (
			<li>
				<button type="button" data-filter={node.slug}>
					{node.label}
				</button>
				{node.children.length > 0 && <CategoryTree nodes={node.children} depth={depth + 1} />}
			</li>
		))
	}
</ul>

<style>
	.cat-tree {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.cat-tree[data-depth='0'] {
		margin-bottom: 0.3em;
	}
	.cat-tree:not([data-depth='0']) {
		padding-left: 0.9em;
	}
	.cat-tree button {
		display: block;
		width: 100%;
		text-align: left;
		padding: 0.25em 0;
		border: none;
		background: none;
		color: rgb(var(--muted));
		font-size: 0.9em;
		cursor: pointer;
	}
	.cat-tree button.active {
		color: rgb(var(--ink));
		font-weight: 600;
	}
	.cat-tree button:hover {
		color: var(--accent);
	}
</style>

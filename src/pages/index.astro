---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { CATEGORIES, SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.filters {
				display: flex;
				gap: 1.4em;
				margin-bottom: 2.8em;
				border-bottom: 1px solid var(--line);
				padding-bottom: 0.9em;
			}
			.filters button {
				padding: 0;
				border: none;
				background: none;
				color: rgb(var(--muted));
				font-size: 0.9em;
				letter-spacing: 0.02em;
				cursor: pointer;
			}
			.filters button.active {
				color: rgb(var(--ink));
				font-weight: 600;
			}
			.filters button:hover {
				color: var(--accent);
			}
			ul {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			li {
				margin-bottom: 2em;
				padding-bottom: 2em;
				border-bottom: 1px solid var(--line);
			}
			li:last-child {
				border-bottom: none;
			}
			li.hidden {
				display: none;
			}
			.title {
				margin: 0.3em 0 0.3em 0;
			}
			.title a {
				color: rgb(var(--ink));
				text-decoration: none;
			}
			.title a:hover {
				color: var(--accent);
			}
			.meta {
				margin: 0;
				color: rgb(var(--muted));
				font-size: 0.82em;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.meta .category {
				color: var(--accent-ink);
			}
			.description {
				margin: 0;
				color: rgb(var(--muted));
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="filters" id="filters">
				<button type="button" data-filter="all" class="active">전체</button>
				{
					CATEGORIES.map((c) => (
						<button type="button" data-filter={c.id}>
							{c.label}
						</button>
					))
				}
			</div>
			<ul id="post-list">
				{
					posts.map((post) => (
						<li data-category={post.data.category}>
							<p class="meta">
								<span class="category">
									{CATEGORIES.find((c) => c.id === post.data.category)?.label}
								</span>
								{' · '}
								<FormattedDate date={post.data.date} />
							</p>
							<h2 class="title">
								<a href={`${BASE}posts/${post.id}/`}>{post.data.title}</a>
							</h2>
							{post.data.description && <p class="description">{post.data.description}</p>}
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
		<script>
			const buttons = document.querySelectorAll<HTMLButtonElement>('#filters button');
			const items = document.querySelectorAll<HTMLLIElement>('#post-list li');

			for (const button of buttons) {
				button.addEventListener('click', () => {
					const filter = button.dataset.filter;
					for (const b of buttons) b.classList.toggle('active', b === button);
					for (const item of items) {
						const show = filter === 'all' || item.dataset.category === filter;
						item.classList.toggle('hidden', !show);
					}
				});
			}
		</script>
	</body>
</html>

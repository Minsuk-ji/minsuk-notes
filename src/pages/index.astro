---
import CategoryTree from '../components/CategoryTree.astro';
import FormattedDate from '../components/FormattedDate.astro';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { buildCategoryTree, categoryLabelPath } from '../lib/categories';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
	(a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const categoryTree = buildCategoryTree(posts.map((p) => p.data.category));
const BASE = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<style>
			.home-main {
				width: 900px;
			}
			.layout {
				display: grid;
				grid-template-columns: 180px 1fr;
				gap: 3em;
			}
			.sidebar {
				position: sticky;
				top: 2em;
				align-self: start;
			}
			.sidebar .all-btn {
				display: block;
				width: 100%;
				text-align: left;
				padding: 0.25em 0;
				margin-bottom: 0.3em;
				border: none;
				background: none;
				color: rgb(var(--muted));
				font-size: 0.9em;
				font-weight: 600;
				cursor: pointer;
			}
			.sidebar .all-btn.active {
				color: rgb(var(--ink));
			}
			.sidebar .all-btn:hover {
				color: var(--accent);
			}
			ul.post-list {
				list-style-type: none;
				margin: 0;
				padding: 0;
			}
			ul.post-list li {
				margin-bottom: 2em;
				padding-bottom: 2em;
				border-bottom: 1px solid var(--line);
			}
			ul.post-list li:last-child {
				border-bottom: none;
			}
			ul.post-list li.hidden {
				display: none;
			}
			.title {
				margin: 0.3em 0 0.3em 0;
			}
			.title a {
				color: rgb(var(--ink));
				text-decoration: none;
			}
			.title a:hover {
				color: var(--accent);
			}
			.meta {
				margin: 0;
				color: rgb(var(--muted));
				font-size: 0.82em;
				letter-spacing: 0.04em;
				text-transform: uppercase;
			}
			.meta .category {
				color: var(--accent-ink);
			}
			.description {
				margin: 0;
				color: rgb(var(--muted));
			}
			.empty {
				color: rgb(var(--muted));
			}
			@media (max-width: 640px) {
				.layout {
					grid-template-columns: 1fr;
				}
				.sidebar {
					position: static;
					display: flex;
					flex-wrap: wrap;
					gap: 0 1.2em;
					border-bottom: 1px solid var(--line);
					padding-bottom: 1em;
					margin-bottom: 1.5em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="home-main">
			<div class="layout">
				<aside class="sidebar" id="filters">
					<button type="button" class="all-btn active" data-filter="all">전체</button>
					<CategoryTree nodes={categoryTree} />
				</aside>
				<div>
					<ul class="post-list" id="post-list">
						{
							posts.map((post) => (
								<li data-category={post.data.category}>
									<p class="meta">
										<span class="category">{categoryLabelPath(post.data.category)}</span>
										{' · '}
										<FormattedDate date={post.data.date} />
									</p>
									<h2 class="title">
										<a href={`${BASE}posts/${post.id}/`}>{post.data.title}</a>
									</h2>
									{post.data.description && <p class="description">{post.data.description}</p>}
								</li>
							))
						}
					</ul>
					{posts.length === 0 && <p class="empty">아직 글이 없습니다.</p>}
				</div>
			</div>
		</main>
		<Footer />
		<script>
			const buttons = document.querySelectorAll<HTMLButtonElement>('#filters [data-filter]');
			const items = document.querySelectorAll<HTMLLIElement>('#post-list li');

			for (const button of buttons) {
				button.addEventListener('click', () => {
					const filter = button.dataset.filter!;
					for (const b of buttons) b.classList.toggle('active', b === button);
					for (const item of items) {
						const cat = item.dataset.category ?? '';
						const show = filter === 'all' || cat === filter || cat.startsWith(`${filter}/`);
						item.classList.toggle('hidden', !show);
					}
				});
			}
		</script>
	</body>
</html>

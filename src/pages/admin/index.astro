---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import { CATEGORIES, SITE_TITLE } from '../../consts';
---

<!doctype html>
<html lang="ko">
	<head>
		<BaseHead title={`관리자 · ${SITE_TITLE}`} description="글 목록/작성/수정" />
		<meta name="robots" content="noindex,nofollow" />
		<style>
			.admin-main {
				width: 960px;
				max-width: calc(100% - 2.5em);
				margin: auto;
				padding: 2.5em 0;
			}
			.token-box {
				max-width: 480px;
			}
			.token-box p {
				color: rgb(var(--muted));
				font-size: 0.92em;
			}
			.token-box input[type='password'] {
				width: 100%;
				padding: 0.6em 0.7em;
				border: 1px solid var(--line);
				border-radius: 4px;
				background: white;
				margin-bottom: 0.8em;
			}
			button {
				padding: 0.55em 1.1em;
				border: 1px solid rgb(var(--ink));
				border-radius: 4px;
				background: rgb(var(--ink));
				color: var(--paper);
				cursor: pointer;
				font-size: 0.92em;
			}
			button.secondary {
				background: none;
				color: rgb(var(--ink));
			}
			button.danger {
				background: none;
				border-color: var(--accent);
				color: var(--accent);
			}
			button:disabled {
				opacity: 0.5;
				cursor: default;
			}
			.layout {
				display: grid;
				grid-template-columns: 220px 1fr;
				gap: 2.5em;
			}
			.sidebar-head {
				display: flex;
				justify-content: space-between;
				align-items: center;
				margin-bottom: 1em;
			}
			.sidebar-head h2 {
				font-size: 1em;
				margin: 0;
			}
			#post-list {
				list-style: none;
				margin: 0;
				padding: 0;
			}
			#post-list li a {
				display: block;
				padding: 0.5em 0;
				color: rgb(var(--muted));
				text-decoration: none;
				font-size: 0.92em;
				border-bottom: 1px solid var(--line);
			}
			#post-list li a:hover,
			#post-list li a.active {
				color: rgb(var(--ink));
			}
			.field {
				margin-bottom: 1.1em;
			}
			.field label {
				display: block;
				font-size: 0.85em;
				color: rgb(var(--muted));
				margin-bottom: 0.3em;
			}
			.field input[type='text'],
			.field input[type='date'],
			.field select,
			.field textarea {
				width: 100%;
				padding: 0.5em 0.6em;
				border: 1px solid var(--line);
				border-radius: 4px;
				background: white;
				font-size: 0.95em;
			}
			.field textarea {
				min-height: 380px;
				font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
				font-size: 0.88em;
				line-height: 1.6;
				resize: vertical;
			}
			.row {
				display: flex;
				gap: 1em;
			}
			.row .field {
				flex: 1;
			}
			.checkbox-field {
				display: flex;
				align-items: center;
				gap: 0.5em;
			}
			.checkbox-field label {
				margin: 0;
			}
			.actions {
				display: flex;
				gap: 0.8em;
				align-items: center;
				margin-top: 1.5em;
			}
			#status {
				font-size: 0.88em;
				color: rgb(var(--muted));
			}
			#status.error {
				color: var(--accent);
			}
			#editor {
				display: none;
			}
			@media (max-width: 720px) {
				.layout {
					grid-template-columns: 1fr;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main class="admin-main">
			<div id="login-view" class="token-box">
				<h1>관리자 로그인</h1>
				<p>
					이 레포(<code>Minsuk-ji/minsuk-notes</code>)에만 쓰기 권한이 있는 GitHub fine-grained PAT을
					만들어 붙여넣으세요. 토큰은 이 브라우저의 localStorage에만 저장되고, 그대로 GitHub API에 직접
					요청을 보내는 데만 쓰입니다.
				</p>
				<p>
					<a
						href="https://github.com/settings/personal-access-tokens/new"
						target="_blank"
						rel="noopener"
					>
						토큰 새로 만들기 ↗
					</a>
					— Repository access를 "Only select repositories → minsuk-notes"로, Permissions →
					Repository permissions → <strong>Contents: Read and write</strong>로 설정하세요.
				</p>
				<input type="password" id="token-input" placeholder="github_pat_..." autocomplete="off" />
				<button id="login-btn" type="button">저장하고 시작</button>
			</div>

			<div id="editor">
				<div class="sidebar-head" style="grid-column: 1 / -1;">
					<h1 style="margin:0; font-size:1.3em;">글 관리</h1>
					<button class="secondary" id="logout-btn" type="button">로그아웃</button>
				</div>
				<div class="layout">
					<div>
						<div class="sidebar-head">
							<h2>글 목록</h2>
							<button id="new-btn" type="button" title="새 글">+ 새 글</button>
						</div>
						<ul id="post-list"></ul>
					</div>
					<div>
						<input type="hidden" id="f-path" />
						<input type="hidden" id="f-sha" />
						<div class="field" id="slug-field">
							<label for="f-slug">파일명 (slug, 영문 소문자/숫자/하이픈)</label>
							<input type="text" id="f-slug" placeholder="my-new-post" />
						</div>
						<div class="field">
							<label for="f-title">제목</label>
							<input type="text" id="f-title" />
						</div>
						<div class="field">
							<label for="f-description">설명 (목록/RSS용 한 줄)</label>
							<input type="text" id="f-description" />
						</div>
						<div class="row">
							<div class="field">
								<label for="f-date">날짜</label>
								<input type="date" id="f-date" />
							</div>
							<div class="field">
								<label for="f-category">카테고리</label>
								<select id="f-category">
									{CATEGORIES.map((c) => <option value={c.id}>{c.label}</option>)}
								</select>
							</div>
						</div>
						<div class="field">
							<label for="f-tags">태그 (쉼표로 구분)</label>
							<input type="text" id="f-tags" placeholder="nvm, shell" />
						</div>
						<div class="field checkbox-field">
							<input type="checkbox" id="f-draft" />
							<label for="f-draft">draft (공개하지 않음)</label>
						</div>
						<div class="field">
							<label for="f-body">본문 (마크다운)</label>
							<textarea id="f-body"></textarea>
						</div>
						<div class="actions">
							<button id="save-btn" type="button">저장 (커밋 &amp; 배포)</button>
							<button class="danger" id="delete-btn" type="button">삭제</button>
							<span id="status"></span>
						</div>
					</div>
				</div>
			</div>
		</main>

		<script>
			const OWNER = 'Minsuk-ji';
			const REPO = 'minsuk-notes';
			const BRANCH = 'main';
			const POSTS_PATH = 'src/content/posts';
			const TOKEN_KEY = 'mn_admin_token';

			const $ = <T extends HTMLElement = HTMLElement>(id: string) => document.getElementById(id) as T;

			const loginView = $('login-view');
			const editor = $('editor');
			const status = $('status');

			function getToken(): string | null {
				return localStorage.getItem(TOKEN_KEY);
			}
			function setToken(token: string) {
				localStorage.setItem(TOKEN_KEY, token);
			}
			function clearToken() {
				localStorage.removeItem(TOKEN_KEY);
			}

			function utf8ToBase64(str: string): string {
				const bytes = new TextEncoder().encode(str);
				let binary = '';
				for (const b of bytes) binary += String.fromCharCode(b);
				return btoa(binary);
			}
			function base64ToUtf8(b64: string): string {
				const binary = atob(b64.replace(/\n/g, ''));
				const bytes = Uint8Array.from(binary, (c) => c.charCodeAt(0));
				return new TextDecoder().decode(bytes);
			}

			async function api(path: string, options: RequestInit = {}) {
				const token = getToken();
				const res = await fetch(`https://api.github.com/repos/${OWNER}/${REPO}${path}`, {
					...options,
					headers: {
						Authorization: `Bearer ${token}`,
						Accept: 'application/vnd.github+json',
						'X-GitHub-Api-Version': '2022-11-28',
						...(options.body ? { 'Content-Type': 'application/json' } : {}),
						...options.headers,
					},
				});
				if (!res.ok) {
					let message = res.statusText;
					try {
						const body = await res.json();
						message = body.message || message;
					} catch {
						// ignore
					}
					throw new Error(`${res.status} ${message}`);
				}
				if (res.status === 204) return null;
				return res.json();
			}

			interface PostData {
				title: string;
				description: string;
				date: string;
				category: string;
				tags: string[];
				draft: boolean;
			}

			function parsePost(raw: string): PostData & { body: string } {
				const defaults: PostData = {
					title: '',
					description: '',
					date: new Date().toISOString().slice(0, 10),
					category: 'study',
					tags: [],
					draft: false,
				};
				const m = raw.match(/^---\r?\n([\s\S]*?)\r?\n---\r?\n?([\s\S]*)$/);
				if (!m) return { ...defaults, body: raw };
				const [, fm, rest] = m;
				const data = { ...defaults };
				for (const rawLine of fm.split(/\r?\n/)) {
					const line = rawLine.trim();
					const idx = line.indexOf(':');
					if (idx === -1) continue;
					const key = line.slice(0, idx).trim();
					const value = line.slice(idx + 1).trim();
					if (key === 'title' || key === 'description') {
						const qm = value.match(/^'(.*)'$/s);
						(data as any)[key] = qm ? qm[1].replace(/''/g, "'") : value;
					} else if (key === 'date' || key === 'category') {
						(data as any)[key] = value;
					} else if (key === 'tags') {
						const inner = value.replace(/^\[/, '').replace(/\]$/, '');
						data.tags = inner
							? inner
									.split(',')
									.map((s) => s.trim().replace(/^'(.*)'$/s, '$1').replace(/''/g, "'"))
									.filter(Boolean)
							: [];
					} else if (key === 'draft') {
						data.draft = value === 'true';
					}
				}
				return { ...data, body: rest.replace(/^\r?\n/, '') };
			}

			function escapeYamlSingle(s: string): string {
				return String(s ?? '').replace(/'/g, "''");
			}

			function stringifyPost(data: PostData, body: string): string {
				const lines = [
					'---',
					`title: '${escapeYamlSingle(data.title)}'`,
					`description: '${escapeYamlSingle(data.description)}'`,
					`date: ${data.date}`,
					`category: ${data.category}`,
					`tags: [${data.tags.map((t) => `'${escapeYamlSingle(t)}'`).join(', ')}]`,
					`draft: ${data.draft}`,
					'---',
					'',
					body.trim(),
					'',
				];
				return lines.join('\n');
			}

			function slugify(s: string): string {
				return s
					.trim()
					.toLowerCase()
					.replace(/[^a-z0-9]+/g, '-')
					.replace(/^-+|-+$/g, '');
			}

			function setStatus(msg: string, isError = false) {
				status.textContent = msg;
				status.classList.toggle('error', isError);
			}

			async function listPosts(): Promise<{ name: string; path: string }[]> {
				const items = await api(`/contents/${POSTS_PATH}?ref=${BRANCH}`);
				return items
					.filter((i: any) => i.type === 'file' && /\.mdx?$/.test(i.name))
					.map((i: any) => ({ name: i.name, path: i.path }))
					.sort((a: any, b: any) => a.name.localeCompare(b.name));
			}

			async function loadPost(path: string) {
				const res = await api(`/contents/${path}?ref=${BRANCH}`);
				const raw = base64ToUtf8(res.content);
				return { sha: res.sha as string, ...parsePost(raw) };
			}

			async function savePost(opts: {
				path: string;
				sha?: string;
				content: string;
				message: string;
			}) {
				return api(`/contents/${opts.path}`, {
					method: 'PUT',
					body: JSON.stringify({
						message: opts.message,
						content: utf8ToBase64(opts.content),
						sha: opts.sha,
						branch: BRANCH,
					}),
				});
			}

			async function deletePost(opts: { path: string; sha: string; message: string }) {
				return api(`/contents/${opts.path}`, {
					method: 'DELETE',
					body: JSON.stringify({ message: opts.message, sha: opts.sha, branch: BRANCH }),
				});
			}

			// ── Form <-> state ──────────────────────────────────────────
			const fSlug = $<HTMLInputElement>('f-slug');
			const fSlugField = $('slug-field');
			const fPath = $<HTMLInputElement>('f-path');
			const fSha = $<HTMLInputElement>('f-sha');
			const fTitle = $<HTMLInputElement>('f-title');
			const fDescription = $<HTMLInputElement>('f-description');
			const fDate = $<HTMLInputElement>('f-date');
			const fCategory = $<HTMLSelectElement>('f-category');
			const fTags = $<HTMLInputElement>('f-tags');
			const fDraft = $<HTMLInputElement>('f-draft');
			const fBody = $<HTMLTextAreaElement>('f-body');
			const deleteBtn = $<HTMLButtonElement>('delete-btn');
			const postList = $<HTMLUListElement>('post-list');

			function clearForm(forNew: boolean) {
				fPath.value = '';
				fSha.value = '';
				fSlug.value = '';
				fSlugField.style.display = forNew ? '' : 'none';
				fTitle.value = '';
				fDescription.value = '';
				fDate.value = new Date().toISOString().slice(0, 10);
				fCategory.value = 'study';
				fTags.value = '';
				fDraft.checked = false;
				fBody.value = '';
				deleteBtn.style.display = forNew ? 'none' : '';
				for (const li of postList.querySelectorAll('a')) li.classList.remove('active');
			}

			function fillForm(path: string, data: PostData & { sha: string; body: string }) {
				fPath.value = path;
				fSha.value = data.sha;
				fSlugField.style.display = 'none';
				fTitle.value = data.title;
				fDescription.value = data.description;
				fDate.value = data.date;
				fCategory.value = data.category;
				fTags.value = data.tags.join(', ');
				fDraft.checked = data.draft;
				fBody.value = data.body;
				deleteBtn.style.display = '';
			}

			async function refreshList(selectPath?: string) {
				postList.innerHTML = '<li>불러오는 중...</li>';
				try {
					const posts = await listPosts();
					postList.innerHTML = '';
					for (const post of posts) {
						const li = document.createElement('li');
						const a = document.createElement('a');
						a.href = '#';
						a.textContent = post.name.replace(/\.mdx?$/, '');
						if (post.path === selectPath) a.classList.add('active');
						a.addEventListener('click', async (e) => {
							e.preventDefault();
							setStatus('불러오는 중...');
							try {
								const data = await loadPost(post.path);
								fillForm(post.path, data);
								for (const other of postList.querySelectorAll('a')) other.classList.remove('active');
								a.classList.add('active');
								setStatus('');
							} catch (err: any) {
								setStatus(err.message, true);
							}
						});
						li.appendChild(a);
						postList.appendChild(li);
					}
				} catch (err: any) {
					postList.innerHTML = '';
					setStatus(err.message, true);
				}
			}

			$<HTMLButtonElement>('new-btn').addEventListener('click', () => {
				clearForm(true);
				setStatus('');
				fSlug.focus();
			});

			$<HTMLButtonElement>('save-btn').addEventListener('click', async () => {
				const isNew = !fPath.value;
				let path = fPath.value;
				if (isNew) {
					const slug = slugify(fSlug.value);
					if (!slug) {
						setStatus('파일명(slug)을 입력하세요.', true);
						return;
					}
					path = `${POSTS_PATH}/${slug}.md`;
				}
				if (!fTitle.value.trim()) {
					setStatus('제목을 입력하세요.', true);
					return;
				}
				const data: PostData = {
					title: fTitle.value.trim(),
					description: fDescription.value.trim(),
					date: fDate.value,
					category: fCategory.value,
					tags: fTags.value
						.split(',')
						.map((t) => t.trim())
						.filter(Boolean),
					draft: fDraft.checked,
				};
				const content = stringifyPost(data, fBody.value);
				setStatus('저장 중...');
				try {
					const res = await savePost({
						path,
						sha: fSha.value || undefined,
						content,
						message: isNew ? `Add post: ${data.title}` : `Update post: ${data.title}`,
					});
					fPath.value = path;
					fSha.value = res.content.sha;
					fSlugField.style.display = 'none';
					deleteBtn.style.display = '';
					setStatus('저장됨 — 잠시 후 사이트에 자동 반영됩니다 (Actions 빌드 중).');
					await refreshList(path);
				} catch (err: any) {
					setStatus(err.message, true);
				}
			});

			deleteBtn.addEventListener('click', async () => {
				if (!fPath.value) return;
				if (!confirm(`"${fTitle.value}" 글을 정말 삭제할까요?`)) return;
				setStatus('삭제 중...');
				try {
					await deletePost({
						path: fPath.value,
						sha: fSha.value,
						message: `Delete post: ${fTitle.value}`,
					});
					clearForm(false);
					setStatus('삭제됨.');
					await refreshList();
				} catch (err: any) {
					setStatus(err.message, true);
				}
			});

			$<HTMLButtonElement>('logout-btn').addEventListener('click', () => {
				clearToken();
				showLoginView();
			});

			$<HTMLButtonElement>('login-btn').addEventListener('click', () => {
				const token = $<HTMLInputElement>('token-input').value.trim();
				if (!token) return;
				setToken(token);
				showEditorView();
			});

			function showLoginView() {
				loginView.style.display = '';
				editor.style.display = 'none';
			}

			async function showEditorView() {
				loginView.style.display = 'none';
				editor.style.display = 'block';
				clearForm(true);
				await refreshList();
			}

			if (getToken()) {
				showEditorView();
			} else {
				showLoginView();
			}
		</script>
	</body>
</html>
